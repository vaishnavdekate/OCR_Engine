            },
            "type": "array",
            "title": "Box"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "observations": {
            "type": "integer",
            "title": "Observations",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "amount",
          "id",
          "role",
          "score",
          "ocr_confidence",
          "source_text",
          "box"
        ],
        "title": "Candidate"
      },
      "DocumentResult": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "processing_ms": {
            "type": "integer",
            "title": "Processing Ms"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/ReceiptResult"
            },
            "type": "array",
            "title": "Pages"
          }
        },
        "type": "object",
        "required": [
          "filename",
